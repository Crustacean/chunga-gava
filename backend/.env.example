# --- Database ---
DATABASE_URL=postgresql+psycopg://chungagava:chungagava@localhost:5432/chungagava

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
# bcrypt hash of the admin password - generate with: python -m app.core.security hash <password>
ADMIN_PASSWORD_HASH=

# --- Geofence ---
GEOFENCE_COUNTRY=Kenya
GEOFENCE_MIN_LAT=-4.9
GEOFENCE_MAX_LAT=5.1
GEOFENCE_MIN_LNG=33.5
GEOFENCE_MAX_LNG=41.9

# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Object storage (MinIO/S3) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=chungagava
S3_SECRET_KEY=chungagava123
S3_BUCKET=chungagava-uploads
S3_REGION=us-east-1

# --- SMS gateway (Africa's Talking) ---
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Email dispatch (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@chungagava.ke

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
